{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RNA-Gym V0.6 provenance observation contract",
  "type": "object",
  "required": [
    "source_id",
    "source_release",
    "raw_sha256",
    "assay_id",
    "sequence_id",
    "cell_id",
    "readout_id",
    "label_raw_unit",
    "label_formula",
    "scientific_review_status"
  ],
  "properties": {
    "source_id": {},
    "source_release": {},
    "source_doi": {},
    "source_accession": {},
    "raw_sha256": {},
    "rights_research": {},
    "rights_evaluate": {},
    "rights_redistribute": {},
    "rights_aggregate": {},
    "assay_id": {},
    "assay_method": {},
    "design_group_id": {},
    "construct_id": {},
    "sequence_id": {},
    "source_sequence": {},
    "nucleotide_alphabet": {},
    "sequence_region": {},
    "inserted_region": {},
    "actual_5utr_boundary": {},
    "cds_boundary": {},
    "stop_boundary": {},
    "actual_3utr_boundary": {},
    "cell_id": {},
    "cell_ontology": {},
    "species": {},
    "delivery_mode": {},
    "cap_type": {},
    "nucleotide_modification": {},
    "polyA_design_length": {},
    "polyA_design_topology": {},
    "polyA_measured_length_method": {},
    "protein_cds_id": {},
    "backbone_id": {},
    "dose": {},
    "batch_id": {},
    "biological_replicate": {},
    "technical_replicate": {},
    "timepoint_value": {},
    "timepoint_unit": {},
    "readout_id": {},
    "readout_method": {},
    "label_raw": {},
    "label_raw_unit": {},
    "label_formula": {},
    "label_transform": {},
    "label_direction": {},
    "detection_limit": {},
    "missing_value_reason": {},
    "view_id": {},
    "split_id": {},
    "split_hash": {},
    "group_fields": {},
    "provenance_status": {},
    "scientific_review_status": {},
    "reviewer_evidence": {},
    "rights_review_status": {}
  },
  "unknown_policy": "UNKNOWN or NOT_REPORTED; never infer common cap/CDS/delivery/batch or biological replicate",
  "license_policy": "copy-specific approval, independent of source-level license",
  "scientific_status_default": "SCIENTIFIC_HOLD",
  "raw_source_values": "retained without sign flip or zero imputation"
}
